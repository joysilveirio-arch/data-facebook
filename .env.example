APP_NAME="Facebook Text Sentiment System"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

DB_PATH="./backend/data/app.db"
DATASET_DIR="./backend/data"
DEFAULT_DATASET="data_facebook.csv"
ARTIFACT_DIR="./backend/artifacts"

TFIDF_MAX_FEATURES=5000
TFIDF_NGRAM_MIN=1
TFIDF_NGRAM_MAX=2
TEST_SIZE=0.2
RANDOM_STATE=42
MIN_SAMPLES_TO_TRAIN=10

CORS_ORIGINS=["*"]